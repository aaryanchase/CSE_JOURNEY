{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build and run current C file",
      "type": "shell",
      "command": "gcc -g \"${file}\" -o \"${fileDirname}/${fileBasenameNoExtension}\" && \"${fileDirname}/${fileBasenameNoExtension}\"",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"],
      "presentation": { "reveal": "always", "focus": true }
    }
  ]
}
